 421: function filterGrid(query) {
 422:   const q = query.toLowerCase();
 423:   document.querySelectorAll(".workspace-lane").forEach((lane) => {
 424:     const cards = [...lane.querySelectorAll(".tab-card")];
 425:     let anyVisible = false;
 426:     for (const card of cards) {
 427:       const title = (
 428:         card.querySelector(".card-title")?.textContent ?? ""
 429:       ).toLowerCase();
 430:       const url = (card.dataset.tabUrl ?? "").toLowerCase();
 431:       const matches = title.includes(q) || url.includes(q);
 432:       card.style.display = matches ? "" : "none";
 433:       if (matches) anyVisible = true;
 434:     }
 435:     lane.style.display = anyVisible || cards.length === 0 ? "" : "none";
 436:   });
 437: }
