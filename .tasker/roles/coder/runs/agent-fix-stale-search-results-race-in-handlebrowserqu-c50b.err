 573: async function handleBrowserQuery(query) {
 574:   browserSearchActive = true;
 575: 
 576:   filterGrid(query);
 577: 
 578:   const r = await search(query);
 579:   const { localSearch } = await chrome.storage.sync.get("localSearch");
 580:   const ls = localSearch ?? { tabs: true, bookmarks: true, history: true };
 581:   if (!ls.tabs) r.tabs = [];
 582:   if (!ls.bookmarks) r.bookmarks = [];
 583:   if (!ls.history) r.history = [];
 584:   if (!browserSearchActive) return;
 585:   browserSearchResults = r;
 586: 
 587:   renderSearchResults(r, query);
 588: }
