 511: function renderSearchResults(results, query) {
 512:   let container = document.getElementById("browser-search-results");
 513:   if (!container) {
 514:     container = document.createElement("div");
 515:     container.id = "browser-search-results";
 516:     document
 517:       .getElementById("workspace-container")
 518:       .insertAdjacentElement("afterend", container);
 519:   }
 520:   container.innerHTML = "";
 521: 
 522:   const sections = [
 523:     { label: "Open Tabs", items: results.tabs },
 524:     { label: "Bookmarks", items: results.bookmarks },
 525:     { label: "History", items: results.history },
 526:   ];
 527: 
 528:   for (const { label, items } of sections) {
 529:     if (!items.length) continue;
 530:     const section = document.createElement("div");
 531:     section.className = "search-results-section";
 532: 
 533:     const heading = document.createElement("div");
 534:     heading.className = "search-results-label";
 535:     heading.textContent = label;
 536:     section.appendChild(heading);
 537: 
 538:     for (const item of items.slice(0, 10)) {
 539:       section.appendChild(buildResultRow(item));
 540:     }
 541:     container.appendChild(section);
 542:   }
 543: 
 544:   if (
 545:     !results.tabs.length &&
 546:     !results.bookmarks.length &&
 547:     !results.history.length
 548:   ) {
 549:     const empty = document.createElement("div");
 550:     empty.className = "search-results-empty";
 551:     const msg = document.createElement("span");
 552:     msg.textContent = `No results for "${query}" â€” `;
 553:     const webBtn = document.createElement("button");
 554:     webBtn.className = "search-web-fallback";
 555:     webBtn.textContent = "search the web";
 556:     webBtn.addEventListener("click", async () => {
 557:       const PROVIDER_URLS = {
 558:         google: "https://www.google.com/search?q=",
 559:         duckduckgo: "https://duckduckgo.com/?q=",
 560:         bing: "https://www.bing.com/search?q=",
 561:         brave: "https://search.brave.com/search?q=",
 562:       };
 563:       const { searchProvider } = await chrome.storage.sync.get("searchProvider");
 564:       const base = PROVIDER_URLS[searchProvider] ?? PROVIDER_URLS.google;
 565:       chrome.tabs.create({ url: base + encodeURIComponent(query) });
 566:     });
 567:     empty.appendChild(msg);
 568:     empty.appendChild(webBtn);
 569:     container.appendChild(empty);
